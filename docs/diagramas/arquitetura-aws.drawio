        <mxCell id="estn" value="A imagem é &lt;b&gt;promovida por ambiente&lt;/b&gt;: o mesmo commit gera duas tags, uma em cada ECR (IAC-ADR-015).&lt;br&gt;Segredos &lt;b&gt;nunca&lt;/b&gt; passam pelo Git: o bootstrap lê do SSM e cria os Secrets no cluster (IAC-ADR-022).&lt;br&gt;O overlay de produção chama-se &lt;b&gt;prod&lt;/b&gt;; o ambiente Terraform chama-se &lt;b&gt;prd&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#37474F;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1020" y="2186" width="320" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="efm" value="Ambientes efêmeros — o que não sobrevive a um destroy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#EF6C00;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="1380" y="2150" width="420" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="efmt" value="· URL do execute-api e API keys do gateway&lt;br&gt;· imagens no ECR (o ECR está dentro do módulo stack)&lt;br&gt;· endpoint, senha e dados do RDS — Flyway reaplica V1..V3&lt;br&gt;· Secrets do cluster e senha inicial do ArgoCD&lt;br&gt;&lt;br&gt;&lt;b&gt;Sobrevivem&lt;/b&gt;, em states separados: o bucket S3 do backend de state.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nada gerado por apply é constante.&lt;/b&gt; URL, API key, endpoint e senha são saídas lidas em tempo de uso — terraform output e SSM.&lt;br&gt;&lt;br&gt;Ordem de subida: &lt;b&gt;rede → banco → stack&lt;/b&gt;. Destruir é o inverso, e scripts/aws-lb-cleanup.sh roda antes." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#5D4037;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1398" y="2184" width="388" height="206" as="geometry"/>
        </mxCell>
